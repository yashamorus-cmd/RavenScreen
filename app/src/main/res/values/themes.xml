<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Тема «Нічний ворон». Material3.Dark — завжди темна, незалежно від налаштувань телефона.
         Кнопки, поля й картки (зокрема картка відповіді поверх екрана) беруть кольори звідси. -->
    <style name="Base.Theme.RavenScreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/raven_moon</item>
        <item name="colorOnPrimary">@color/raven_on_moon</item>
        <item name="colorPrimaryContainer">@color/raven_moon_container</item>
        <item name="colorOnPrimaryContainer">@color/raven_on_moon_container</item>

        <item name="colorSecondary">@color/raven_silver</item>
        <item name="colorOnSecondary">@color/raven_on_silver</item>
        <item name="colorSecondaryContainer">@color/raven_silver_container</item>
        <item name="colorOnSecondaryContainer">@color/raven_on_silver_container</item>

        <item name="android:colorBackground">@color/raven_night</item>
        <item name="colorOnBackground">@color/raven_text</item>
        <item name="colorSurface">@color/raven_night</item>
        <item name="colorOnSurface">@color/raven_text</item>
        <!-- Material 1.10 фарбує filled-картки саме цим кольором -->
        <item name="colorSurfaceVariant">@color/raven_surface_high</item>
        <item name="colorOnSurfaceVariant">@color/raven_text_muted</item>
        <item name="colorSurfaceContainerLow">@color/raven_surface</item>
        <item name="colorSurfaceContainer">@color/raven_surface</item>
        <item name="colorSurfaceContainerHigh">@color/raven_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/raven_surface_high</item>
        <item name="colorOutline">@color/raven_outline</item>

        <item name="colorError">@color/raven_error</item>
        <item name="colorOnError">@color/raven_on_error</item>

        <!-- Звичайні TextView без власного кольору теж стають світлими -->
        <item name="android:textColorPrimary">@color/raven_text</item>
        <item name="android:textColorSecondary">@color/raven_text_muted</item>
        <item name="android:textColorHint">@color/raven_text_muted</item>

        <!-- Рядок стану й нижня панель зливаються з фоном; іконки на них світлі -->
        <item name="android:statusBarColor">@color/raven_night</item>
        <item name="android:navigationBarColor">@color/raven_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.RavenScreen" parent="Base.Theme.RavenScreen" />

    <!-- Картка з тонкою рамкою: однаковий вигляд для всіх блоків головного екрана -->
    <style name="Widget.RavenScreen.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/raven_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Дрібний надпис великими літерами над карткою -->
    <style name="Widget.RavenScreen.Overline" parent="">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Один крок інструкції: номер у кружечку + текст -->
    <style name="Widget.RavenScreen.StepRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.RavenScreen.StepNumber" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_step_number</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/raven_on_moon_container</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.RavenScreen.StepText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
