<!-- Палітра «Нічний ворон»: усі кольори застосунку в одному місці.
     Тема (themes.xml) посилається на них, а екрани беруть кольори з теми. -->
<resources>
    <!-- Нічне небо: фон і поверхні від найтемнішої до найсвітлішої -->
    <color name="raven_night">#0E141D</color>
    <color name="raven_surface">#172130</color>
    <color name="raven_surface_high">#1F2B3D</color>
    <color name="raven_outline">#3A4A60</color>

    <!-- Місячне світло: основний акцент -->
    <color name="raven_moon">#9CCBF0</color>
    <color name="raven_on_moon">#082A44</color>
    <color name="raven_moon_container">#1E4566</color>
    <color name="raven_on_moon_container">#D2E8FB</color>

    <!-- Сріблясте пір'я: другорядний сріблясто-сірий -->
